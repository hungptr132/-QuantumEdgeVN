# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
# Local portable Postgres (see docs/DECISIONS.md). The data directory lives on
# C: (NTFS), not this repo's drive: E: is exFAT, which lacks the fsync
# guarantees PostgreSQL needs.

QE_DATABASE_URL=postgresql+psycopg://qe_owner:CHANGE_ME@localhost:55432/quantumedge
QE_TEST_DATABASE_URL=postgresql+psycopg://qe_owner:CHANGE_ME@localhost:55432/quantumedge_test

QE_TIMEZONE=Asia/Ho_Chi_Minh

# Password issued to the read-only web role. The web app gets ONLY this one,
# and it has no privilege on any base table — just the published_ticker_page view.
QE_WEB_PASSWORD=CHANGE_ME_TOO

# --- web/.env.local gets exactly one variable, duplicated deliberately: ---
# DATABASE_URL=postgres://qe_web:CHANGE_ME_TOO@localhost:55432/quantumedge
